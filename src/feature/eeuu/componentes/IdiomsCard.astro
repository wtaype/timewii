---
// src/feature/eeuu/componentes/IdiomsCard.astro
// 🗣️ Slang Americano vs Jergas del Perú
// Equivalencias directas entre modismos de EE.UU. y expresiones populares peruanas
import { IDIOMS_PERU_DATA } from '@semillas/cultureData.js';
---

<div class="wii-eeuu-card wii-card-idioms">
  <div class="wii-card-header">
    <div class="wii-card-icon wii-ico-idioms">
      <i class="fa-solid fa-comments"></i>
    </div>
    <div class="wii-header-titles">
      <h2 class="wii-card-title">Slang Americano vs Jergas del Perú</h2>
      <p class="wii-card-sub">Equivalencias directas entre modismos de EE.UU. y modismos peruanos con pronunciación rápida</p>
    </div>
    <div class="wii-idiom-search-wrapper">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input
        type="text"
        id="idiomSearchInput"
        class="wii-idiom-search-input"
        placeholder="Buscar modismo (ej. piece, clima, papayita)..."
      />
    </div>
  </div>

  <div class="wii-idioms-body">
    <div class="wii-table-responsive-wrapper">
      <table class="wii-custom-table" id="tablaModismos">
        <thead>
          <tr>
            <th>Slang en EE.UU.</th>
            <th>Pronunciación Rápida</th>
            <th>Jerga Equivalente en Perú</th>
            <th>Significado Real (En 3 palabras)</th>
            <th>Situación / Contexto</th>
          </tr>
        </thead>
        <tbody id="tbodyModismos">
          {IDIOMS_PERU_DATA.map((item) => (
            <tr class="wii-idiom-row" data-search={`${item.slangUsa} ${item.jergaPeru} ${item.significado}`.toLowerCase()}>
              <td>
                <span class="wii-cell-country">
                  <span class="wii-flag-tag">🇺🇸</span>
                  <strong class="wii-slang-title">{item.slangUsa}</strong>
                </span>
              </td>
              <td>
                <span class="wii-phonetic-badge">{item.fonetica}</span>
              </td>
              <td>
                <span class="wii-cell-country">
                  <span class="wii-flag-tag">🇵🇪</span>
                  <strong style="color: var(--ok, #00e676);">{item.jergaPeru}</strong>
                </span>
              </td>
              <td>
                <span class="wii-meaning-pill">{item.significado}</span>
              </td>
              <td class="wii-tbl-desc">{item.contextoTurista}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>
