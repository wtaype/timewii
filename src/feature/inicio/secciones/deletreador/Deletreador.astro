---
// src/feature/inicio/secciones/deletreador/Deletreador.astro
// 🔤 Cuadro 2: Deletreador Fonético Amigable con Botones Rápidos y Pronunciación en Español
---

<div class="gen-card gen-card--speller" id="cuadroDeletreador">
  <div class="gen-card-header">
    <div class="gen-header-title">
      <i class="fa-solid fa-spell-check gen-icon-mco"></i>
      <span>Deletreador Amigable</span>
    </div>

    <!-- Botones Directos de Modo Fonético -->
    <div class="gen-speller-modes" id="genSpellerModes">
      <button type="button" class="gen-mode-btn active" data-mode="things" title="Estados y lugares familiares">Lugares</button>
      <button type="button" class="gen-mode-btn" data-mode="names" title="Nombres de persona en inglés">Nombres</button>
      <button type="button" class="gen-mode-btn" data-mode="military" title="Alfabeto OTAN / Militar">Militar</button>
    </div>
  </div>

  <!-- Input de Deletreo Monospace -->
  <div class="gen-speller-input-wrap">
    <input 
      type="text" 
      class="gen-speller-input" 
      id="genSpellerInput" 
      placeholder="ESCRIBE PALABRA, CÓDIGO O APELLIDO (EJ: TEXAS O WILDER)..." 
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" class="gen-speller-clear-btn" id="genSpellerClearBtn" title="Limpiar texto">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- Barra Informativa -->
  <div class="gen-speller-actions-bar">
    <span class="gen-speller-hint" id="genSpellerCountHint">Ingresa letras o números arriba para ver el desglose fonético</span>
  </div>

  <!-- Resultado Reactivo en Fichas Horizontales -->
  <div class="gen-speller-output-box" id="genSpellerOutput">
    <span class="gen-empty-state-text">
      Escribe en la caja de arriba para ver el desglose fonético en tiempo real...
    </span>
  </div>
</div>
