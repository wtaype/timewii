---
// src/feature/inicio/secciones/00-general/cuadros/03_direcciones.astro
// 📬 Cuadro 3: Direcciones USPS Comunes con Buscador y Enlace Directo USPS LOCATOR
---

<div class="gen-card gen-card--direcciones" id="cuadroDirecciones">
  <div class="gen-card-header">
    <div class="gen-header-title">
      <i class="fa-solid fa-envelopes-bulk gen-icon-mco"></i>
      <span>Direcciones USPS & Sufijos</span>
    </div>
    <!-- Enlace oficial de USPS -->
    <a 
      href="https://tools.usps.com/zip-code-lookup.htm" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="gen-badge-tag gen-badge-link"
      title="Abrir buscador oficial de direcciones y ZIP codes de USPS"
    >
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
      <span>USPS LOCATOR</span>
    </a>
  </div>

  <!-- Buscador de Abreviaciones -->
  <div class="gen-search-box gen-search-box--sm">
    <i class="fa-solid fa-magnifying-glass gen-search-icon"></i>
    <input 
      type="text" 
      class="gen-input-search" 
      id="genUspsSearchInput" 
      placeholder="Filtrar (ej: AVE, CIR, Road, APT)..." 
      autocomplete="off"
    />
  </div>

  <!-- Cuadrícula de Abreviaciones USPS en 2 columnas -->
  <div class="gen-pill-grid" id="genAbbrGrid">
    <div class="gen-pill-item" data-code="AVE" data-name="Avenue">
      <span class="gen-pill-code">AVE</span>
      <span class="gen-pill-text">Avenue (Avenida)</span>
    </div>
    <div class="gen-pill-item" data-code="BLVD" data-name="Boulevard">
      <span class="gen-pill-code">BLVD</span>
      <span class="gen-pill-text">Boulevard</span>
    </div>
    <div class="gen-pill-item" data-code="CIR" data-name="Circle">
      <span class="gen-pill-code">CIR</span>
      <span class="gen-pill-text">Circle (Círculo)</span>
    </div>
    <div class="gen-pill-item" data-code="CT" data-name="Court">
      <span class="gen-pill-code">CT</span>
      <span class="gen-pill-text">Court (Corte)</span>
    </div>
    <div class="gen-pill-item" data-code="DR" data-name="Drive">
      <span class="gen-pill-code">DR</span>
      <span class="gen-pill-text">Drive</span>
    </div>
    <div class="gen-pill-item" data-code="LN" data-name="Lane">
      <span class="gen-pill-code">LN</span>
      <span class="gen-pill-text">Lane (Callejón)</span>
    </div>
    <div class="gen-pill-item" data-code="PKWY" data-name="Parkway">
      <span class="gen-pill-code">PKWY</span>
      <span class="gen-pill-text">Parkway</span>
    </div>
    <div class="gen-pill-item" data-code="PL" data-name="Place">
      <span class="gen-pill-code">PL</span>
      <span class="gen-pill-text">Place (Plaza)</span>
    </div>
    <div class="gen-pill-item" data-code="RD" data-name="Road">
      <span class="gen-pill-code">RD</span>
      <span class="gen-pill-text">Road (Camino)</span>
    </div>
    <div class="gen-pill-item" data-code="ST" data-name="Street">
      <span class="gen-pill-code">ST</span>
      <span class="gen-pill-text">Street (Calle)</span>
    </div>
    <div class="gen-pill-item" data-code="WAY" data-name="Way">
      <span class="gen-pill-code">WAY</span>
      <span class="gen-pill-text">Way</span>
    </div>
    <div class="gen-pill-item" data-code="HWY" data-name="Highway">
      <span class="gen-pill-code">HWY</span>
      <span class="gen-pill-text">Highway</span>
    </div>
    <div class="gen-pill-item" data-code="APT" data-name="Apartment">
      <span class="gen-pill-code">APT</span>
      <span class="gen-pill-text">Apartment (Apto)</span>
    </div>
    <div class="gen-pill-item" data-code="STE" data-name="Suite">
      <span class="gen-pill-code">STE</span>
      <span class="gen-pill-text">Suite</span>
    </div>
    <div class="gen-pill-item" data-code="UNIT" data-name="Unit">
      <span class="gen-pill-code">UNIT</span>
      <span class="gen-pill-text">Unit (Unidad)</span>
    </div>
    <div class="gen-pill-item" data-code="BLDG" data-name="Building">
      <span class="gen-pill-code">BLDG</span>
      <span class="gen-pill-text">Building (Edif)</span>
    </div>
  </div>
</div>
