---
// src/feature/inicio/secciones/00-general/cuadros/04_numeros.astro
// 🔢 Cuadro 4: Números & Cifras con Deletreador Interactivo y Fichas en 2 Columnas
---

<div class="gen-card gen-card--numeros" id="cuadroNumeros">
  <div class="gen-card-header">
    <div class="gen-header-title">
      <i class="fa-solid fa-arrow-down-1-9 gen-icon-mco"></i>
      <span>Números & Cifras</span>
    </div>
    <span class="gen-badge-tag">Fonética en Vivo</span>
  </div>

  <!-- Input Interactivo Deletreador de Números -->
  <div class="gen-interactive-reader-box">
    <div class="gen-reader-input-row">
      <i class="fa-solid fa-calculator gen-reader-icon"></i>
      <input 
        type="number" 
        class="gen-input-reader" 
        id="genNumberInput" 
        placeholder="Escribe número (ej: 24, 615, 2100, 71779978)..." 
        autocomplete="off"
        min="0"
        max="99999999"
      />
      <button class="gen-btn-clear" id="genNumberClearBtn" title="Limpiar">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Salida en Vivo del Número -->
    <div class="gen-reader-result-card" id="genNumberResultCard">
      <div class="gen-reader-live-label">Lectura en llamada:</div>
      <div class="gen-reader-live-text" id="genNumberLiveText">Escribe una cifra arriba...</div>
      <div class="gen-reader-live-sub" id="genNumberLiveSub">Pronunciación natural para miembros de EE.UU.</div>
    </div>
  </div>

  <!-- Fichas de Números en 2 Columnas (Sin tablas ni th) -->
  <div class="gen-pill-grid gen-pill-grid--compact" id="genNumGrid">
    <!-- Renderizado por JS cliente -->
  </div>
</div>
