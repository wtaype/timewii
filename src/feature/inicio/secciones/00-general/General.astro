---
// src/feature/inicio/secciones/00-general/General.astro
// 🌟 Orquestador de la Sección General: Layout 2 Arriba y 4 Abajo
import Estados from './cuadros/01_estados.astro';
import Deletreador from './cuadros/02_deletreador.astro';
import Direcciones from './cuadros/03_direcciones.astro';
import Unidades from './cuadros/06_unidades.astro';
import Numeros from './cuadros/04_numeros.astro';
import Monedas from './cuadros/05_monedas.astro';
---

<section class="general-layout-grid" id="section-general">
  <!-- Fila Superior: 2 Columnas Principales (Uso Intensivo Diario) -->
  <div class="gen-top-row">
    <Estados />
    <Deletreador />
  </div>

  <!-- Fila Inferior: 4 Columnas (Direcciones, Unidades al lado, Números, Monedas) -->
  <div class="gen-bottom-row">
    <Direcciones />
    <Unidades />
    <Numeros />
    <Monedas />
  </div>
</section>
