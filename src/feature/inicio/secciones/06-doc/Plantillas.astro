---
// src/feature/inicio/secciones/06-doc/Plantillas.astro
// Módulo de Plantillas de notas oficiales para CRM Teleperformance / Wellcare Centene
import { CRM_TEMPLATES } from '../../lib/notasData.js';
---

<section class="plantillas-layout" id="section-plantillas">
  
  <div class="plantillas-header-card">
    <div class="header-left">
      <div class="header-badge">Documentación CRM</div>
      <h2 class="header-title">
        <i class="fa-solid fa-file-lines"></i>
        <span>Plantillas Oficiales de Notas (1-Click Copy)</span>
      </h2>
      <p class="header-desc">
        Formatos estándar auditados para documentar incidencias de llamada, transferencias, problemas de audio y llamadas no autorizadas. Copia y pega directamente en tu CRM.
      </p>
    </div>
    <div class="qa-compliance-chip">
      <i class="fa-solid fa-shield-halved"></i>
      <span>Cumplimiento CMS & HIPAA</span>
    </div>
  </div>

  <div class="templates-grid">
    {CRM_TEMPLATES.map(tpl => (
      <div class="template-card" id={`tpl-${tpl.id}`}>
        <div class="template-top">
          <div class="template-meta">
            <span class="category-badge">{tpl.category}</span>
            <h3 class="template-title">{tpl.title}</h3>
          </div>
          <button class="btn-copy-template" data-copy={tpl.content} title="Copiar plantilla completa">
            <i class="fa-regular fa-copy"></i> Copiar Nota
          </button>
        </div>

        <p class="template-description">{tpl.description}</p>

        <pre class="template-content-box"><code>{tpl.content}</code></pre>
      </div>
    ))}
  </div>

</section>
