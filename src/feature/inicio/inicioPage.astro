---
// src/feature/inicio/inicioPage.astro
// Orquestador Principal del Dashboard TimeWii · Wellcare Advisor Toolkit
import General from './secciones/00-general/General.astro';
import Time from './secciones/01-time/Time.astro';
import Usa from './secciones/02-usa/Usa.astro';
import English from './secciones/03-english/English.astro';
import Timers from './secciones/05-timers/Timers.astro';
import Learn from './secciones/07-learn/Learn.astro';

// Estilos modulares procesados automáticamente por Vite (minificación 100% y 0 peticiones de red)
import './inicio.css';
import './secciones/00-general/general.css';
import './secciones/01-time/time.css';
import './secciones/02-usa/usa.css';
import './secciones/03-english/english.css';
import './secciones/05-timers/timers.css';
import './secciones/07-learn/learn.css';
---

<div class="dashboard-app">
  
  <!-- ========================================== -->
  <!-- 1. SIDEBAR LATERAL ESTILO TEAMS           -->
  <!-- ========================================== -->
  <aside class="dashboard-sidebar" id="dashboardSidebar">
    
    <div class="sidebar-header">
      <div class="brand-badge-icon">
        <i class="fa-solid fa-heart-pulse"></i>
      </div>
      <div class="brand-info">
        <div class="brand-title">TIME<span>WII</span></div>
        <div class="brand-sub">Smart tools for you</div>
      </div>
    </div>

    <!-- Navegación de Herramientas -->
    <nav class="sidebar-menu">
      <div class="menu-label">Herramientas Asesor</div>
      
      <button class="nav-tab-btn active" data-view="panel-general">
        <i class="fa-solid fa-gauge-high"></i>
        <span class="nav-tab-text">GENERAL</span>
      </button>

      <button class="nav-tab-btn" data-view="panel-time">
        <i class="fa-solid fa-clock"></i>
        <span class="nav-tab-text">TIME US</span>
      </button>

      <button class="nav-tab-btn" data-view="panel-usa">
        <i class="fa-solid fa-map-location-dot"></i>
        <span class="nav-tab-text">STATES50</span>
      </button>

      <button class="nav-tab-btn" data-view="panel-english">
        <i class="fa-solid fa-comments"></i>
        <span class="nav-tab-text">PHRASES</span>
      </button>

      <button class="nav-tab-btn" data-view="panel-timers">
        <i class="fa-solid fa-stopwatch-20"></i>
        <span class="nav-tab-text">TIMERS</span>
      </button>

      <button class="nav-tab-btn" data-view="panel-learn">
        <i class="fa-solid fa-spell-check"></i>
        <span class="nav-tab-text">SPELLED</span>
      </button>
    </nav>

    <!-- Footer del Sidebar Reorganizado -->
    <div class="sidebar-bottom">
      <!-- Botón Cambio de Tema (Luz / Futuro) -->
      <button class="sidebar-action-btn" id="btnThemeToggle" title="Cambiar Tema (Claro / Futuro)">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
        <span id="themeBtnText">Tema</span>
      </button>

      <!-- Botón About / Privacidad y Soporte -->
      <button class="sidebar-action-btn" id="btnAboutModal" title="Acerca de TimeWii">
        <i class="fa-solid fa-circle-info"></i>
        <span>ABOUT</span>
      </button>

      <!-- Botón Colapsar Sidebar -->
      <button class="sidebar-action-btn" id="btnToggleSidebar" title="Colapsar menú lateral">
        <i class="fa-solid fa-angles-left" id="sidebarToggleIcon"></i>
        <span>COLLAPSE</span>
      </button>
    </div>

  </aside>

  <!-- ========================================== -->
  <!-- 2. VIEWPORT PRINCIPAL (100VH VERTICAL)     -->
  <!-- ========================================== -->
  <div class="dashboard-viewport">
    
    <!-- Contenedor con Scroll de las Secciones (Sin header superior para máximo espacio) -->
    <main class="dashboard-content-scroll">
      
      <div class="view-panel active" id="panel-general">
        <General />
      </div>

      <div class="view-panel" id="panel-time">
        <Time />
      </div>

      <div class="view-panel" id="panel-usa">
        <Usa />
      </div>

      <div class="view-panel" id="panel-english">
        <English />
      </div>

      <div class="view-panel" id="panel-timers">
        <Timers />
      </div>

      <div class="view-panel" id="panel-learn">
        <Learn />
      </div>

    </main>

  </div>

</div>

<!-- ========================================== -->
<!-- 3. MODAL ABOUT (widev/modales.js)          -->
<!-- ========================================== -->
<div class="wi_modal_about modal-overlay" id="modalAbout">
  <div class="about-modal-card">
    <div class="about-modal-header">
      <div class="about-title-row">
        <div class="brand-badge-icon">
          <i class="fa-solid fa-heart-pulse"></i>
        </div>
        <div>
          <h3>Acerca de TimeWii</h3>
          <span class="gen-badge-tag">Versión 2.0 · Professional Toolkit</span>
        </div>
      </div>
      <button class="modal-close-icon-btn" data-modal-close title="Cerrar modal">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="about-modal-body">
      <p>
        <strong>TimeWii</strong> es una estación de trabajo de alta velocidad desarrollada específicamente para optimizar el rendimiento y la precisión de asesores telefónicos en campañas de salud Medicare / Wellcare.
      </p>

      <div class="about-features-list">
        <div class="about-feature-item">
          <i class="fa-solid fa-shield-halved"></i>
          <div><strong>100% Local & Seguro:</strong> No almacena datos en la nube ni transmite información sensible a servidores de terceros. Toda la ejecución ocurre en tu propio navegador.</div>
        </div>

        <div class="about-feature-item">
          <i class="fa-solid fa-bolt-lightning"></i>
          <div><strong>Cero Latencia:</strong> Búsqueda instantánea de estados, rangos de Códigos ZIP, deletreador de nombres y conversión fonética de números y copagos en milisegundos.</div>
        </div>

        <div class="about-feature-item">
          <i class="fa-solid fa-user-doctor"></i>
          <div><strong>Fines Educativos & Operativos:</strong> Diseñado como apoyo ergonómico en llamada conforme a las mejores prácticas de servicio al cliente.</div>
        </div>
      </div>
    </div>

    <div class="about-modal-footer">
      <button class="sidebar-action-btn" data-modal-close>
        <i class="fa-solid fa-check"></i>
        <span>Entendido</span>
      </button>
    </div>
  </div>
</div>

<!-- Toast flotante de confirmación -->
<div class="toast-msg" id="globalToast">
  <i class="fa-solid fa-circle-check"></i>
  <span id="globalToastText">¡Acción realizada con éxito!</span>
</div>

<!-- ============================================================ -->
<!-- ⚙️ SCRIPT CLIENT-SIDE LOCAL Y REACTIVO                        -->
<!-- ============================================================ -->
<script>
  import { ESTADOS_DATA, ZONAS_HORARIAS } from './lib/estadosData.js';
  import { FRASES_DATA } from './lib/frasesData.js';
  import { US_STATE_PHONETICS } from './lib/phoneticData.js';
  import { NUMEROS_DATA, MONEDAS_DATA, numeroAIngles, numeroAInglesColoquial, monedaAIngles } from './lib/numerosMonedasData.js';
  import { UNIDADES_MED_DATA } from './lib/unidadesMedData.js';
  import { wicopy } from '../../core/widev/widev.js';
  import { abrirModal } from '../../core/widev/modales.js';

  // 1. FORMATEO DE HORAS Y RELOJES EN TIEMPO REAL
  function formatTime(tz?: string) {
    const d = new Date();
    const opts: Intl.DateTimeFormatOptions = {
      hour12: true,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit'
    };
    if (tz) opts.timeZone = tz;

    const formatter = new Intl.DateTimeFormat('en-US', opts);
    const parts = formatter.formatToParts(d);
    let h = '', m = '', s = '', ap = '';
    parts.forEach(p => {
      if (p.type === 'hour') h = p.value;
      if (p.type === 'minute') m = p.value;
      if (p.type === 'second') s = p.value;
      if (p.type === 'dayPeriod') ap = p.value.toUpperCase();
    });
    return { time: `${h}:${m}:${s}`, ampm: ap };
  }

  function updateAllClocks() {
    const local = formatTime();
    // Actualizar <title> dinámico en vivo en la pestaña
    document.title = `${local.time} ${local.ampm} · Timewii`;

    // Panel Time (Relojes de Estados Unidos)
    const e = formatTime(ZONAS_HORARIAS.eastern);
    const c = formatTime(ZONAS_HORARIAS.central);
    const m = formatTime(ZONAS_HORARIAS.mountain);
    const p = formatTime(ZONAS_HORARIAS.pacific);
    const a = formatTime(ZONAS_HORARIAS.alaska);
    const hw = formatTime(ZONAS_HORARIAS.hawaii);

    const elE = document.getElementById('clockEastern');
    const elC = document.getElementById('clockCentral');
    const elM = document.getElementById('clockMountain');
    const elP = document.getElementById('clockPacific');
    const elA = document.getElementById('clockAlaska');
    const elH = document.getElementById('clockHawaii');

    if (elE) elE.innerHTML = `${e.time} <span class="clock-ampm">${e.ampm}</span>`;
    if (elC) elC.innerHTML = `${c.time} <span class="clock-ampm">${c.ampm}</span>`;
    if (elM) elM.innerHTML = `${m.time} <span class="clock-ampm">${m.ampm}</span>`;
    if (elP) elP.innerHTML = `${p.time} <span class="clock-ampm">${p.ampm}</span>`;
    if (elA) elA.innerHTML = `${a.time} <span class="clock-ampm">${a.ampm}</span>`;
    if (elH) elH.innerHTML = `${hw.time} <span class="clock-ampm">${hw.ampm}</span>`;
  }

  setInterval(updateAllClocks, 1000);
  updateAllClocks();

  // 2. CAMBIO DE TEMA EN EL FOOTER DEL SIDEBAR
  const btnTheme = document.getElementById('btnThemeToggle');
  const themeIcon = document.getElementById('themeIcon');
  const themeBtnText = document.getElementById('themeBtnText');

  function syncThemeIcon() {
    const current = document.documentElement.dataset.theme || 'futuro';
    if (themeIcon) {
      themeIcon.className = current === 'futuro' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
    }
    if (themeBtnText) {
      themeBtnText.textContent = current === 'futuro' ? 'Modo Luz' : 'Futuro';
    }
  }

  syncThemeIcon();

  btnTheme?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme || 'futuro';
    const next = current === 'futuro' ? 'luz' : 'futuro';
    if ((window as any).cambiarTemaGlobal) {
      (window as any).cambiarTemaGlobal(next);
    } else {
      document.documentElement.dataset.theme = next;
      localStorage.setItem('wiTema', next);
    }
    syncThemeIcon();
  });

  // 3. MODAL ABOUT CON WIDEV
  const btnAbout = document.getElementById('btnAboutModal');
  btnAbout?.addEventListener('click', () => {
    abrirModal('modalAbout');
  });

  // 4. NAVEGACIÓN ENTRE PESTAÑAS DEL SIDEBAR
  const navBtns = document.querySelectorAll('.nav-tab-btn');
  const panels = document.querySelectorAll('.view-panel');

  navBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-view') || '';
      navBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      panels.forEach(p => p.classList.remove('active'));
      document.getElementById(target)?.classList.add('active');
    });
  });

  // 5. COLAPSO DEL SIDEBAR
  const sidebar = document.getElementById('dashboardSidebar');
  const btnToggle = document.getElementById('btnToggleSidebar');
  const toggleIcon = document.getElementById('sidebarToggleIcon');

  btnToggle?.addEventListener('click', () => {
    sidebar?.classList.toggle('collapsed');
    const isCol = sidebar?.classList.contains('collapsed');
    if (toggleIcon) {
      toggleIcon.className = isCol ? 'fa-solid fa-angles-right' : 'fa-solid fa-angles-left';
    }
  });

  // 6. TOAST GLOBAL DE COPIADO (Para secciones donde aún se use)
  function showToast(msg: string) {
    const toast = document.getElementById('globalToast');
    const toastText = document.getElementById('globalToastText');
    if (toast && toastText) {
      toastText.textContent = msg;
      toast.style.display = 'flex';
      setTimeout(() => { toast.style.display = 'none'; }, 2200);
    }
  }

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-copy]') as HTMLElement | null;
    if (target) {
      const text = target.getAttribute('data-copy') || '';
      if (text) {
        wicopy(text, (ok) => {
          if (ok) showToast('Copiado al portapapeles');
        });
      }
    }
  });

  // 7. SECCIÓN GENERAL - CUADRO 1: ESTADOS CON ZIP CODE & BÚSQUEDA
  const genStatesBody = document.getElementById('genStatesTableBody');
  const genStateInput = document.getElementById('genStateSearchInput') as HTMLInputElement | null;
  const genStateClear = document.getElementById('genStateClearBtn');
  const genStateCounter = document.getElementById('genStateCounter');

  function renderEstadosGeneral(query = '') {
    if (!genStatesBody) return;
    genStatesBody.innerHTML = '';
    const q = query.toLowerCase().trim();

    // Filtrar con asignación de peso de relevancia para que siglas (ej. NV) o ciudades salgan primero
    const matches: { st: typeof ESTADOS_DATA[0]; score: number }[] = [];

    ESTADOS_DATA.forEach(st => {
      const abbrLow = st.abbr.toLowerCase();
      const nameLow = st.name.toLowerCase();
      const citiesLow = (st.cities || '').toLowerCase();
      const zipLow = (st.zip || '').toLowerCase();
      const capLow = (st.cap || '').toLowerCase();
      const codesLow = st.codes.toLowerCase();
      const weatherLow = st.weather.toLowerCase();

      if (!q) {
        matches.push({ st, score: 99 });
        return;
      }

      // Prioridad 1: Coincidencia exacta o inicio en sigla (ej. NV -> Nevada primero)
      if (abbrLow === q) {
        matches.push({ st, score: 1 });
      } else if (abbrLow.startsWith(q)) {
        matches.push({ st, score: 2 });
      } else if (nameLow.startsWith(q)) {
        matches.push({ st, score: 3 });
      } else if (nameLow.includes(q)) {
        matches.push({ st, score: 4 });
      } else if (citiesLow.includes(q)) {
        matches.push({ st, score: 5 });
      } else if (zipLow.includes(q) || capLow.includes(q) || codesLow.includes(q) || weatherLow.includes(q)) {
        matches.push({ st, score: 6 });
      }
    });

    // Ordenar de menor score (más relevante) a mayor score
    matches.sort((a, b) => a.score - b.score);
    const filtered = matches.map(m => m.st);

    if (genStateCounter) {
      genStateCounter.textContent = `${filtered.length} estados`;
    }

    filtered.forEach(st => {
      let tz = ZONAS_HORARIAS.eastern;
      if (st.zone === 'Central') tz = ZONAS_HORARIAS.central;
      if (st.zone === 'Mountain') tz = ZONAS_HORARIAS.mountain;
      if (st.zone === 'Pacific') tz = ZONAS_HORARIAS.pacific;
      if (st.zone === 'Alaska') tz = ZONAS_HORARIAS.alaska;
      if (st.zone === 'Hawaii') tz = ZONAS_HORARIAS.hawaii;
      const t = formatTime(tz);

      const tr = document.createElement('tr');
      // Orden: Sigla | Estado | ZIP Code | Ciudades | Prefijos | Hora Local | Huso | Clima | Capital
      tr.innerHTML = `
        <td class="st-col-abbr">${st.abbr}</td>
        <td class="st-col-name">${st.name}</td>
        <td><span class="st-col-zip">${st.zip}</span></td>
        <td class="st-col-cities">${st.cities || '-'}</td>
        <td>${st.codes}</td>
        <td class="st-col-time">${t.time} ${t.ampm}</td>
        <td><span class="badge-zone ${st.zone.toLowerCase()}">${st.zone}</span></td>
        <td><span class="st-col-weather">${st.weather}</span></td>
        <td>${st.cap}</td>
      `;
      genStatesBody.appendChild(tr);
    });
  }

  renderEstadosGeneral();

  genStateInput?.addEventListener('input', (e) => {
    renderEstadosGeneral((e.target as HTMLInputElement).value);
  });

  genStateClear?.addEventListener('click', () => {
    if (genStateInput) {
      genStateInput.value = '';
      renderEstadosGeneral('');
      genStateInput.focus();
    }
  });

  // 8. SECCIÓN GENERAL - CUADRO 2: DELETREADOR AMIGABLE (SIN BOTONES COPIAR)
  const genSpellerInput = document.getElementById('genSpellerInput') as HTMLInputElement | null;
  const genSpellerOutput = document.getElementById('genSpellerOutput');
  const genSpellerClear = document.getElementById('genSpellerClearBtn');
  const genSpellerHint = document.getElementById('genSpellerCountHint');

  function updateGeneralSpeller() {
    const val = genSpellerInput?.value.toUpperCase().trim() || '';
    if (!genSpellerOutput) return;
    genSpellerOutput.innerHTML = '';

    if (!val) {
      genSpellerOutput.innerHTML = '<span class="gen-empty-state-text">Escribe en la caja de arriba para ver el desglose fonético en tiempo real...</span>';
      if (genSpellerHint) genSpellerHint.textContent = 'Ingresa letras o números arriba para ver el desglose fonético';
      return;
    }

    if (genSpellerHint) {
      genSpellerHint.textContent = `${val.length} caracteres listos para lectura directa`;
    }

    for (const char of val) {
      const match = (US_STATE_PHONETICS as any)[char];
      if (match) {
        const card = document.createElement('div');
        card.className = 'gen-spell-card';
        card.innerHTML = `
          <span class="gen-spell-char">${char}</span>
          <span class="gen-spell-word">${match.word}</span>
          <span class="gen-spell-phrase">${match.example}</span>
        `;
        genSpellerOutput.appendChild(card);
      } else if (char === ' ') {
        const space = document.createElement('div');
        space.style.width = '12px';
        space.style.display = 'inline-block';
        genSpellerOutput.appendChild(space);
      } else {
        const card = document.createElement('div');
        card.className = 'gen-spell-card';
        card.innerHTML = `
          <span class="gen-spell-char">${char}</span>
          <span class="gen-spell-word">${char}</span>
          <span class="gen-spell-phrase">Símbolo</span>
        `;
        genSpellerOutput.appendChild(card);
      }
    }
  }

  genSpellerInput?.addEventListener('input', updateGeneralSpeller);

  genSpellerClear?.addEventListener('click', () => {
    if (genSpellerInput) {
      genSpellerInput.value = '';
      updateGeneralSpeller();
      genSpellerInput.focus();
    }
  });

  // 9. SECCIÓN GENERAL - CUADRO 3: DIRECCIONES USPS (SIN BOTONES COPIAR)
  const genUspsInput = document.getElementById('genUspsSearchInput') as HTMLInputElement | null;
  const genAbbrItems = document.querySelectorAll('#genAbbrGrid .gen-pill-item');

  genUspsInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    genAbbrItems.forEach(item => {
      const code = item.getAttribute('data-code')?.toLowerCase() || '';
      const name = item.getAttribute('data-name')?.toLowerCase() || '';
      if (!q || code.includes(q) || name.includes(q)) {
        (item as HTMLElement).style.display = 'flex';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  });

  // 10. SECCIÓN GENERAL - CUADRO 4: NÚMEROS & CIFRAS EN 2 COLUMNAS
  const genNumberInput = document.getElementById('genNumberInput') as HTMLInputElement | null;
  const genNumberClearBtn = document.getElementById('genNumberClearBtn');
  const genNumberLiveText = document.getElementById('genNumberLiveText');
  const genNumberLiveSub = document.getElementById('genNumberLiveSub');
  const genNumGrid = document.getElementById('genNumGrid');

  function updateNumberReader() {
    const raw = genNumberInput?.value.trim() || '';
    if (!genNumberLiveText || !genNumberLiveSub) return;

    if (!raw) {
      genNumberLiveText.textContent = 'Escribe una cifra arriba...';
      genNumberLiveSub.textContent = 'Pronunciación natural para miembros de EE.UU.';
      return;
    }

    const enText = numeroAIngles(raw);
    const coloquial = numeroAInglesColoquial(raw);

    genNumberLiveText.textContent = enText;
    if (coloquial && coloquial.toLowerCase() !== enText.toLowerCase()) {
      genNumberLiveSub.textContent = `También: "${coloquial}"`;
    } else {
      genNumberLiveSub.textContent = 'Pronunciación estándar CMS';
    }
  }

  function renderGridNumeros() {
    if (!genNumGrid) return;
    genNumGrid.innerHTML = '';
    NUMEROS_DATA.forEach(n => {
      const item = document.createElement('div');
      item.className = 'gen-pill-item';
      item.innerHTML = `
        <span class="gen-pill-code">${n.num}</span>
        <span class="gen-pill-text">${n.en}</span>
      `;
      genNumGrid.appendChild(item);
    });
  }

  renderGridNumeros();
  genNumberInput?.addEventListener('input', updateNumberReader);
  genNumberClearBtn?.addEventListener('click', () => {
    if (genNumberInput) {
      genNumberInput.value = '';
      updateNumberReader();
      genNumberInput.focus();
    }
  });

  // 11. SECCIÓN GENERAL - CUADRO 5: MONEDAS & COPAGOS EN 2 COLUMNAS
  const genMoneyInput = document.getElementById('genMoneyInput') as HTMLInputElement | null;
  const genMoneyClearBtn = document.getElementById('genMoneyClearBtn');
  const genMoneyLiveRapido = document.getElementById('genMoneyLiveRapido');
  const genMoneyLiveFormal = document.getElementById('genMoneyLiveFormal');
  const genMonedaGrid = document.getElementById('genMonedaGrid');

  function updateMoneyReader() {
    const val = genMoneyInput?.value || '';
    if (!genMoneyLiveRapido || !genMoneyLiveFormal) return;

    if (!val.trim()) {
      genMoneyLiveRapido.textContent = 'Escribe un monto arriba...';
      genMoneyLiveFormal.textContent = 'Ejemplo: 5.30, 35, 2000';
      return;
    }

    const res = monedaAIngles(val);
    if (res) {
      genMoneyLiveRapido.textContent = res.rapido;
      genMoneyLiveFormal.textContent = `${res.montoFormateado} · ${res.formal}`;
    } else {
      genMoneyLiveRapido.textContent = 'Monto no reconocido';
      genMoneyLiveFormal.textContent = 'Ingresa números como 5.30 o 35';
    }
  }

  function renderGridMonedas() {
    if (!genMonedaGrid) return;
    genMonedaGrid.innerHTML = '';
    MONEDAS_DATA.forEach(m => {
      const item = document.createElement('div');
      item.className = 'gen-pill-item';
      item.innerHTML = `
        <span class="gen-pill-code">${m.monto}</span>
        <span class="gen-pill-text">${m.enRapido}</span>
      `;
      genMonedaGrid.appendChild(item);
    });
  }

  renderGridMonedas();
  genMoneyInput?.addEventListener('input', updateMoneyReader);
  genMoneyClearBtn?.addEventListener('click', () => {
    if (genMoneyInput) {
      genMoneyInput.value = '';
      updateMoneyReader();
      genMoneyInput.focus();
    }
  });

  // 11.B. SECCIÓN GENERAL - CUADRO 6: UNIDADES FARMACÉUTICAS EN 2 COLUMNAS
  const genUnidadesGrid = document.getElementById('genUnidadesGrid');
  const genUnidadInput = document.getElementById('genUnidadSearchInput') as HTMLInputElement | null;

  function renderGridUnidades(query = '') {
    if (!genUnidadesGrid) return;
    genUnidadesGrid.innerHTML = '';
    const q = query.toLowerCase().trim();

    const filtered = UNIDADES_MED_DATA.filter(u => {
      return u.abrv.toLowerCase().includes(q) ||
             u.name.toLowerCase().includes(q) ||
             u.en.toLowerCase().includes(q) ||
             u.tip.toLowerCase().includes(q);
    });

    filtered.forEach(u => {
      const item = document.createElement('div');
      item.className = 'gen-pill-item';
      item.setAttribute('data-abrv', u.abrv);
      item.setAttribute('data-name', u.name);
      item.innerHTML = `
        <span class="gen-pill-code">${u.abrv}</span>
        <span class="gen-pill-text">${u.name}</span>
      `;
      genUnidadesGrid.appendChild(item);
    });
  }

  renderGridUnidades();
  genUnidadInput?.addEventListener('input', (e) => {
    renderGridUnidades((e.target as HTMLInputElement).value);
  });

  // 12. MAPA TOOLTIP (SECCIÓN USA)
  const mapStates = document.querySelectorAll('.map-state');
  const tooltip = document.getElementById('mapTooltip');
  const mapWrapper = document.querySelector('.us-map-wrapper');

  mapStates.forEach(st => {
    st.addEventListener('mousemove', (ev) => {
      const e = ev as MouseEvent;
      const name = st.getAttribute('data-name');
      const abbr = st.getAttribute('data-abbr');
      const zone = st.getAttribute('data-zone') || 'Eastern';
      const cap = st.getAttribute('data-cap');

      let tz = ZONAS_HORARIAS.eastern;
      if (zone.includes('Central')) tz = ZONAS_HORARIAS.central;
      if (zone.includes('Mountain')) tz = ZONAS_HORARIAS.mountain;
      if (zone.includes('Pacific')) tz = ZONAS_HORARIAS.pacific;
      if (zone.includes('Alaska')) tz = ZONAS_HORARIAS.alaska;
      if (zone.includes('Hawaii')) tz = ZONAS_HORARIAS.hawaii;

      const time = formatTime(tz);

      if (tooltip && mapWrapper) {
        tooltip.innerHTML = `
          <strong>${name} (${abbr})</strong><br/>
          <span>Zona: ${zone}</span><br/>
          <span>Hora: <strong class="st-col-abbr">${time.time} ${time.ampm}</strong></span><br/>
          <span>Capital: ${cap}</span>
        `;
        const rect = mapWrapper.getBoundingClientRect();
        tooltip.style.left = `${e.clientX - rect.left}px`;
        tooltip.style.top = `${e.clientY - rect.top}px`;
        tooltip.style.display = 'block';
      }
    });

    st.addEventListener('mouseleave', () => {
      if (tooltip) tooltip.style.display = 'none';
    });
  });

  // 13. TABLA DE ESTADOS CON CLIMA Y CURIOSIDADES (SECCIÓN USA)
  const statesTbody = document.getElementById('statesTableBody');
  const stateInput = document.getElementById('stateSearchInput') as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll('#section-usa .btn-filter');
  let currentZoneFilter = 'all';

  function renderStates(query = '', zone = 'all') {
    if (!statesTbody) return;
    statesTbody.innerHTML = '';
    const q = query.toLowerCase().trim();

    const filtered = ESTADOS_DATA.filter(st => {
      const matchZone = zone === 'all' || st.zone.toLowerCase().includes(zone.toLowerCase());
      const matchQuery = st.name.toLowerCase().includes(q) ||
                         st.abbr.toLowerCase().includes(q) ||
                         st.zip.toLowerCase().includes(q) ||
                         st.cap.toLowerCase().includes(q) ||
                         st.codes.includes(q) ||
                         st.weather.toLowerCase().includes(q) ||
                         st.fact.toLowerCase().includes(q);
      return matchZone && matchQuery;
    });

    filtered.forEach(st => {
      let tz = ZONAS_HORARIAS.eastern;
      if (st.zone === 'Central') tz = ZONAS_HORARIAS.central;
      if (st.zone === 'Mountain') tz = ZONAS_HORARIAS.mountain;
      if (st.zone === 'Pacific') tz = ZONAS_HORARIAS.pacific;
      if (st.zone === 'Alaska') tz = ZONAS_HORARIAS.alaska;
      if (st.zone === 'Hawaii') tz = ZONAS_HORARIAS.hawaii;
      const t = formatTime(tz);

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="st-col-abbr">${st.abbr}</td>
        <td><strong>${st.name}</strong></td>
        <td><span class="st-col-zip">${st.zip}</span></td>
        <td><span class="badge-zone ${st.zone.toLowerCase()}">${st.zone}</span></td>
        <td class="st-col-time">${t.time} ${t.ampm}</td>
        <td class="st-col-cap">${st.cap}</td>
        <td class="st-col-codes">${st.codes}</td>
        <td><span class="st-col-weather">${st.weather}</span></td>
        <td class="st-col-fact">${st.fact}</td>
      `;
      statesTbody.appendChild(tr);
    });
  }

  renderStates();

  stateInput?.addEventListener('input', (e) => {
    renderStates((e.target as HTMLInputElement).value, currentZoneFilter);
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentZoneFilter = btn.getAttribute('data-filter') || 'all';
      renderStates(stateInput?.value || '', currentZoneFilter);
    });
  });

  // 14. FRASES EN INGLÉS CON COPIADO DE 1-CLICK
  const phrasesGrid = document.getElementById('phrasesGrid');
  const phraseInput = document.getElementById('phraseSearchInput') as HTMLInputElement | null;
  const phraseCatBtns = document.querySelectorAll('#section-english .btn-filter');
  let currentPhraseCat = 'all';

  function renderPhrases(query = '', cat = 'all') {
    if (!phrasesGrid) return;
    phrasesGrid.innerHTML = '';
    const q = query.toLowerCase().trim();

    const filtered = FRASES_DATA.filter(f => {
      const matchCat = cat === 'all' || f.cat === cat;
      const matchQuery = f.en.toLowerCase().includes(q) ||
                         f.es.toLowerCase().includes(q) ||
                         f.catLabel.toLowerCase().includes(q) ||
                         f.tip.toLowerCase().includes(q);
      return matchCat && matchQuery;
    });

    filtered.forEach(f => {
      const card = document.createElement('div');
      card.className = 'phrase-card';
      card.innerHTML = `
        <div class="phrase-card-top">
          <span class="phrase-badge ${f.badgeClass}">${f.catLabel}</span>
        </div>
        <div class="phrase-en-text">"${f.en}"</div>
        <div class="phrase-es-text">${f.es}</div>
        <div class="phrase-tip"><i class="fa-solid fa-lightbulb"></i> ${f.tip}</div>
        <button class="btn-copy-phrase" data-copy="${f.en.replace(/"/g, '&quot;')}">
          <i class="fa-solid fa-copy"></i> Copiar frase
        </button>
      `;
      phrasesGrid.appendChild(card);
    });
  }

  renderPhrases();

  phraseInput?.addEventListener('input', (e) => {
    renderPhrases((e.target as HTMLInputElement).value, currentPhraseCat);
  });

  phraseCatBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      phraseCatBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentPhraseCat = btn.getAttribute('data-cat') || 'all';
      renderPhrases(phraseInput?.value || '', currentPhraseCat);
    });
  });

  // 15. TIMERS (HOLD TIMER 2 MINUTOS & AHT STOPWATCH)
  const HOLD_DURATION = 120;
  let holdRemaining = HOLD_DURATION;
  let holdInterval: any = null;
  let isHoldRunning = false;

  const holdDigits = document.getElementById('holdDigits');
  const holdDisplayBox = document.getElementById('holdDisplayBox');
  const holdIndicator = document.getElementById('holdIndicator');
  const holdStatusText = document.getElementById('holdStatusText');
  const btnHoldStart = document.getElementById('btnHoldStart') as HTMLButtonElement | null;
  const btnHoldPause = document.getElementById('btnHoldPause') as HTMLButtonElement | null;
  const btnHoldReset = document.getElementById('btnHoldReset') as HTMLButtonElement | null;

  function renderHoldDisplay() {
    const mins = Math.floor(holdRemaining / 60).toString().padStart(2, '0');
    const secs = (holdRemaining % 60).toString().padStart(2, '0');
    if (holdDigits) holdDigits.textContent = `${mins}:${secs}`;

    if (holdDisplayBox) {
      holdDisplayBox.classList.remove('warning-state', 'danger-state');
      if (holdRemaining <= 0) {
        holdDisplayBox.classList.add('danger-state');
        if (holdStatusText) holdStatusText.textContent = '¡LÍMITE EXCEDIDO (2 MIN)! Regresa de Hold de inmediato';
        if (holdIndicator) {
          holdIndicator.textContent = '¡ALERTA!';
          holdIndicator.style.background = 'var(--error)';
          holdIndicator.style.color = '#fff';
        }
      } else if (holdRemaining <= 30) {
        holdDisplayBox.classList.add('warning-state');
        if (holdStatusText) holdStatusText.textContent = 'Quedan menos de 30 segundos de espera';
        if (holdIndicator) {
          holdIndicator.textContent = 'Aviso 1:30';
          holdIndicator.style.background = 'var(--warning)';
          holdIndicator.style.color = '#fff';
        }
      } else {
        if (holdStatusText) holdStatusText.textContent = 'Tiempo de espera en curso';
        if (holdIndicator) {
          holdIndicator.textContent = isHoldRunning ? 'En Pausa' : 'Listo';
          holdIndicator.style.background = 'var(--inp)';
          holdIndicator.style.color = 'var(--tx2)';
        }
      }
    }
  }

  btnHoldStart?.addEventListener('click', () => {
    if (isHoldRunning) return;
    isHoldRunning = true;
    if (btnHoldStart) btnHoldStart.disabled = true;
    if (btnHoldPause) btnHoldPause.disabled = false;

    holdInterval = setInterval(() => {
      holdRemaining--;
      renderHoldDisplay();
    }, 1000);
  });

  btnHoldPause?.addEventListener('click', () => {
    isHoldRunning = false;
    clearInterval(holdInterval);
    if (btnHoldStart) btnHoldStart.disabled = false;
    if (btnHoldPause) btnHoldPause.disabled = true;
  });

  btnHoldReset?.addEventListener('click', () => {
    isHoldRunning = false;
    clearInterval(holdInterval);
    holdRemaining = HOLD_DURATION;
    renderHoldDisplay();
    if (btnHoldStart) btnHoldStart.disabled = false;
    if (btnHoldPause) btnHoldPause.disabled = true;
    if (holdStatusText) holdStatusText.textContent = 'Tiempo máximo permitido';
  });

  // AHT Stopwatch
  let ahtSeconds = 0;
  let ahtInterval: any = null;
  let isAhtRunning = false;

  const ahtDigits = document.getElementById('ahtDigits');
  const ahtIndicator = document.getElementById('ahtIndicator');
  const btnAhtStart = document.getElementById('btnAhtStart') as HTMLButtonElement | null;
  const btnAhtPause = document.getElementById('btnAhtPause') as HTMLButtonElement | null;
  const btnAhtReset = document.getElementById('btnAhtReset') as HTMLButtonElement | null;

  function renderAhtDisplay() {
    const mins = Math.floor(ahtSeconds / 60).toString().padStart(2, '0');
    const secs = (ahtSeconds % 60).toString().padStart(2, '0');
    if (ahtDigits) ahtDigits.textContent = `${mins}:${secs}`;
  }

  btnAhtStart?.addEventListener('click', () => {
    if (isAhtRunning) return;
    isAhtRunning = true;
    if (btnAhtStart) btnAhtStart.disabled = true;
    if (btnAhtPause) btnAhtPause.disabled = false;
    if (ahtIndicator) {
      ahtIndicator.textContent = 'Llamada Activa';
      ahtIndicator.style.background = 'rgba(0, 160, 164, 0.2)';
      ahtIndicator.style.color = 'var(--mco)';
    }

    ahtInterval = setInterval(() => {
      ahtSeconds++;
      renderAhtDisplay();
    }, 1000);
  });

  btnAhtPause?.addEventListener('click', () => {
    isAhtRunning = false;
    clearInterval(ahtInterval);
    if (btnAhtStart) btnAhtStart.disabled = false;
    if (btnAhtPause) btnAhtPause.disabled = true;
    if (ahtIndicator) {
      ahtIndicator.textContent = 'Pausada';
      ahtIndicator.style.background = 'var(--inp)';
      ahtIndicator.style.color = 'var(--tx2)';
    }
  });

  btnAhtReset?.addEventListener('click', () => {
    isAhtRunning = false;
    clearInterval(ahtInterval);
    ahtSeconds = 0;
    renderAhtDisplay();
    if (btnAhtStart) btnAhtStart.disabled = false;
    if (btnAhtPause) btnAhtPause.disabled = true;
    if (ahtIndicator) {
      ahtIndicator.textContent = 'Inactivo';
      ahtIndicator.style.background = 'var(--inp)';
      ahtIndicator.style.color = 'var(--tx2)';
    }
  });

  // 16. DELETREADOR DE ESTADOS (PANEL LEARN / SPELLED)
  const spellerInput = document.getElementById('spellerInput') as HTMLInputElement | null;
  const spellerOutput = document.getElementById('spellerOutput');
  const spellerClearBtn = document.getElementById('spellerClearBtn');

  function updateSpeller() {
    const val = spellerInput?.value.toUpperCase().trim() || '';
    if (!spellerOutput) return;
    spellerOutput.innerHTML = '';

    if (!val) {
      spellerOutput.innerHTML = '<span class="speller-empty-hint">El desglose fonético ("W as in Washington, C as in California") aparecerá aquí en tiempo real...</span>';
      return;
    }

    for (const char of val) {
      const match = (US_STATE_PHONETICS as any)[char];
      if (match) {
        const token = document.createElement('div');
        token.className = 'speller-token';
        token.innerHTML = `
          <span class="token-char">${char}</span>
          <span class="token-word">${match.word}</span>
          <span class="token-phrase">${match.example}</span>
        `;
        spellerOutput.appendChild(token);
      } else if (char === ' ') {
        const space = document.createElement('div');
        space.style.width = '16px';
        spellerOutput.appendChild(space);
      } else {
        const raw = document.createElement('div');
        raw.className = 'speller-token';
        raw.innerHTML = `
          <span class="token-char">${char}</span>
          <span class="token-word">Símbolo</span>
        `;
        spellerOutput.appendChild(raw);
      }
    }
  }

  spellerInput?.addEventListener('input', updateSpeller);

  spellerClearBtn?.addEventListener('click', () => {
    if (spellerInput) {
      spellerInput.value = '';
      updateSpeller();
      spellerInput.focus();
    }
  });
</script>
