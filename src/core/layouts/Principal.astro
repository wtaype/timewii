---
// src/core/layouts/Principal.astro
// 🌟 Layout Maestro Unificado TimeWii (Cero Bloqueo, 100% Local y Seguro)
import '../wicss/witema.css';
import '../wicss/app.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { 
  titulo = 'Timewii - Smart tools for you | Wellcare Support',
  descripcion = 'Herramienta de apoyo y productividad para asesores de atención telefónica Wellcare Medicare Advantage en Teleperformance.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="futuro" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <meta name="robots" content="noindex, nofollow" />

  <!-- Tipografía & Iconografía Local Caché -->
  <link rel="stylesheet" href="/google/fonts.min.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Anti-FOUC Inmediato (0ms de parpadeo) -->
  <script is:inline>try{var g=localStorage.getItem('wiTema');document.documentElement.dataset.theme=g||'futuro'}catch(e){}</script>

  <slot name="head" />
</head>

<body>
  <!-- Contenido Principal -->
  <slot />

  <!-- Script de Interactividad del Tema Minificado -->
  <script is:inline>window.cambiarTemaGlobal=function(n){document.documentElement.dataset.theme=n;try{localStorage.setItem('wiTema',n)}catch(e){}window.dispatchEvent(new CustomEvent('witema-changed',{detail:n}))};</script>
</body>
</html>