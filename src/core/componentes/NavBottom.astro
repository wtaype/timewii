---
// src/core/componentes/NavBottom.astro
// 📱 Barra de Navegación Inferior Móvil Universal (Dock Ergonómico VIP)
// z-index: 9999 · 100% Cero CSS Inline · 100% Agnóstico
import configurar from '@semillas/configurar.js';

const currentPath = Astro.url.pathname;
const itemsNav = configurar.navegacion || [];
---

<nav class="wii-nav-bottom" aria-label="Navegación móvil inferior">
  {itemsNav.map((item) => {
    const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
    return (
      <a
        href={item.href}
        class:list={['wii-nav-dock-btn', { active: isActive }]}
        data-nav-id={item.id}
        data-astro-prefetch="hover"
        title={item.label}
      >
        <i class:list={['fa-solid', item.icono]}></i>
        <span>{item.labelCorto || item.label || ''}</span>
      </a>
    );
  })}
</nav>
