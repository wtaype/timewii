---
// C:\mipro\timewii\timewii-web\src\pages\view1.astro
// Timewii - Smart tools for you (Teleperformance / Wellcare Advisor Toolkit)
// 100% Autónomo, seguro, client-side, sin conexión a base de datos.
---

<!DOCTYPE html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Timewii - Smart tools for you | Wellcare Support</title>
  
  <!-- Favicon y Recursos Locales -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/google/fonts.min.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <style>
    /* ============================================================ */
    /* 🎨 DESIGN SYSTEM TIMEWII - DARK DASHBOARD PREMIUM (IMAGEN 3) */
    /* ============================================================ */
    :root {
      --font-main: 'Poppins', system-ui, -apple-system, sans-serif;
      --font-head: 'Outfit', 'Poppins', sans-serif;

      /* Dark Theme Principal (Inspirado en Imagen 3) */
      --bg-app: #080c14;
      --bg-sidebar: #0e1320;
      --bg-card: #131929;
      --bg-card-hover: #192237;
      --bg-card-alt: #161e31;
      --bg-input: #0b0f19;

      --border-subtle: #1c263c;
      --border-focus: #ff6600;

      --text-main: #f3f4f6;
      --text-muted: #94a3b8;
      --text-dim: #64748b;

      /* Acentos cromáticos */
      --accent-orange: #ff6600;
      --accent-orange-hover: #ff7d26;
      --accent-orange-soft: rgba(255, 102, 0, 0.15);
      
      --accent-blue: #38bdf8;
      --accent-blue-soft: rgba(56, 189, 248, 0.15);
      
      --accent-green: #10b981;
      --accent-green-soft: rgba(16, 185, 129, 0.15);

      --accent-yellow: #f59e0b;
      --accent-yellow-soft: rgba(245, 158, 11, 0.15);

      --accent-purple: #a855f7;
      --accent-purple-soft: rgba(168, 85, 247, 0.15);

      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-pill: 9999px;

      --sidebar-width: 250px;
      --sidebar-collapsed: 74px;
      --topbar-height: 64px;
      --trans-speed: 0.25s ease;
    }

    /* Reset global */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-main);
      background-color: var(--bg-app);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
      font-size: 14px;
      line-height: 1.5;
    }

    /* Scrollbar estilizada */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg-app);
    }
    ::-webkit-scrollbar-thumb {
      background: #243049;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--accent-orange);
    }

    /* ============================================================ */
    /* 🏛️ LAYOUT: SIDEBAR + MAIN VIEW                               */
    /* ============================================================ */
    .app-layout {
      display: flex;
      width: 100vw;
      min-height: 100vh;
      overflow: hidden;
    }

    /* Sidebar lateral */
    .sidebar {
      width: var(--sidebar-width);
      background-color: var(--bg-sidebar);
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      transition: width var(--trans-speed);
      position: relative;
      z-index: 100;
    }

    .sidebar.collapsed {
      width: var(--sidebar-collapsed);
    }

    /* Header del Sidebar */
    .sidebar-brand {
      height: var(--topbar-height);
      display: flex;
      align-items: center;
      padding: 0 18px;
      gap: 12px;
      border-bottom: 1px solid var(--border-subtle);
      overflow: hidden;
      white-space: nowrap;
    }

    .brand-logo-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, #ff6600, #ff8c00);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 18px;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(255, 102, 0, 0.35);
      flex-shrink: 0;
    }

    .brand-info {
      display: flex;
      flex-direction: column;
      transition: opacity var(--trans-speed);
    }
    .sidebar.collapsed .brand-info {
      opacity: 0;
      pointer-events: none;
    }

    .brand-name {
      font-family: var(--font-head);
      font-size: 17px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .brand-name span {
      color: var(--accent-orange);
    }

    .brand-slogan {
      font-size: 11px;
      color: var(--text-dim);
      font-weight: 400;
      white-space: nowrap;
    }

    /* Lista de Navegación */
    .sidebar-nav {
      flex: 1;
      padding: 16px 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      overflow-y: auto;
    }

    .nav-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--text-dim);
      font-weight: 600;
      padding: 8px 12px 4px;
      white-space: nowrap;
      transition: opacity var(--trans-speed);
    }
    .sidebar.collapsed .nav-label {
      opacity: 0;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 11px 14px;
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      text-decoration: none;
      font-weight: 500;
      cursor: pointer;
      border: 1px solid transparent;
      background: transparent;
      width: 100%;
      text-align: left;
      font-family: inherit;
      font-size: 13.5px;
      transition: all var(--trans-speed);
      white-space: nowrap;
    }

    .nav-item i {
      font-size: 16px;
      width: 20px;
      text-align: center;
      flex-shrink: 0;
      color: var(--text-dim);
      transition: color var(--trans-speed);
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.04);
      color: #fff;
    }
    .nav-item:hover i {
      color: var(--accent-orange);
    }

    .nav-item.active {
      background: var(--accent-orange-soft);
      color: var(--accent-orange);
      border-color: rgba(255, 102, 0, 0.3);
      font-weight: 600;
    }
    .nav-item.active i {
      color: var(--accent-orange);
    }

    .sidebar.collapsed .nav-text {
      display: none;
    }

    /* Footer del Sidebar */
    .sidebar-footer {
      padding: 12px 10px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .btn-collapse {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      font-size: 12.5px;
      cursor: pointer;
      font-family: inherit;
      transition: all var(--trans-speed);
    }
    .btn-collapse:hover {
      background: var(--bg-card);
      color: #fff;
      border-color: var(--accent-orange);
    }
    .sidebar.collapsed .btn-collapse span {
      display: none;
    }

    .safe-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.2);
      color: var(--accent-green);
      font-size: 11px;
      font-weight: 500;
      white-space: nowrap;
    }
    .safe-badge i {
      font-size: 12px;
      flex-shrink: 0;
    }
    .sidebar.collapsed .safe-badge span {
      display: none;
    }

    /* ============================================================ */
    /* 🖥️ MAIN VIEW CONTAINER                                      */
    /* ============================================================ */
    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      background: var(--bg-app);
    }

    /* Topbar Superior */
    .topbar {
      height: var(--topbar-height);
      background: var(--bg-sidebar);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      flex-shrink: 0;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .view-title-wrap h1 {
      font-family: var(--font-head);
      font-size: 18px;
      font-weight: 700;
      color: #fff;
    }
    .view-title-wrap p {
      font-size: 11.5px;
      color: var(--text-dim);
    }

    /* Ticker en vivo de Zonas Horarias */
    .time-ticker-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
      padding: 4px 0;
    }

    .zone-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-pill);
      padding: 5px 12px;
      font-size: 12px;
      white-space: nowrap;
    }
    .zone-pill .pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }
    .zone-pill.eastern .pill-dot { background: #ef4444; }
    .zone-pill.central .pill-dot { background: #eab308; }
    .zone-pill.mountain .pill-dot { background: #10b981; }
    .zone-pill.pacific .pill-dot { background: #f97316; }

    .zone-pill .pill-tag {
      font-weight: 600;
      color: var(--text-muted);
    }
    .zone-pill .pill-time {
      font-weight: 700;
      color: #fff;
      font-family: monospace;
      letter-spacing: 0.5px;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn-action-primary {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--accent-orange);
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(255, 102, 0, 0.25);
      transition: all var(--trans-speed);
    }
    .btn-action-primary:hover {
      background: var(--accent-orange-hover);
      transform: translateY(-1px);
    }

    /* Área de Vistas con Scroll */
    .view-content-area {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
    }

    .view-panel {
      display: none;
      flex-direction: column;
      gap: 24px;
      animation: fadeIn 0.25s ease-out;
    }
    .view-panel.active {
      display: flex;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Tarjetas Generales */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 20px;
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .card-title {
      font-family: var(--font-head);
      font-size: 15px;
      font-weight: 600;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .card-title i {
      color: var(--accent-orange);
    }

    /* ============================================================ */
    /* 🕒 VISTA 1: TIME (RELOJES Y MAPA OFICIAL TIPO TIME.GOV)      */
    /* ============================================================ */
    .time-grid-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
    }

    .clock-card {
      background: var(--bg-card-alt);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      overflow: hidden;
      transition: all var(--trans-speed);
    }
    .clock-card:hover {
      border-color: rgba(255, 102, 0, 0.4);
      transform: translateY(-2px);
    }
    .clock-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }
    .clock-card.eastern::before { background: #ef4444; }
    .clock-card.central::before { background: #eab308; }
    .clock-card.mountain::before { background: #10b981; }
    .clock-card.pacific::before { background: #f97316; }
    .clock-card.alaska::before { background: #06b6d4; }
    .clock-card.hawaii::before { background: #a855f7; }

    .clock-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .clock-zone-name {
      font-size: 13px;
      font-weight: 600;
      color: #fff;
    }
    .clock-zone-tag {
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-muted);
      font-weight: 600;
    }

    .clock-digital-time {
      font-size: 26px;
      font-weight: 800;
      color: #fff;
      font-family: 'Outfit', monospace;
      letter-spacing: 0.5px;
      display: flex;
      align-items: baseline;
      gap: 4px;
    }
    .clock-digital-time .clock-ampm {
      font-size: 13px;
      color: var(--accent-orange);
      font-weight: 700;
    }

    .clock-cities {
      font-size: 11px;
      color: var(--text-dim);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Contenedor del Mapa US Zonas Horarias */
    .map-container-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 22px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .map-legend-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }
    .map-legend-item {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      color: var(--text-muted);
      cursor: pointer;
      padding: 4px 8px;
      border-radius: var(--radius-sm);
      transition: background var(--trans-speed);
    }
    .map-legend-item:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
    }
    .map-legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 3px;
    }

    .us-map-wrapper {
      position: relative;
      width: 100%;
      min-height: 380px;
      background: #0b0f19;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow: hidden;
    }

    .us-map-svg {
      width: 100%;
      max-height: 480px;
      height: auto;
    }

    .map-state {
      stroke: #080c14;
      stroke-width: 1.2;
      transition: filter 0.2s, stroke-width 0.2s, opacity 0.2s;
      cursor: pointer;
    }
    .map-state:hover {
      filter: brightness(1.25);
      stroke: #ffffff;
      stroke-width: 2;
    }

    /* Clases por Zona para Mapa */
    .st-eastern { fill: #dc2626; }
    .st-central { fill: #d97706; }
    .st-mountain { fill: #059669; }
    .st-pacific { fill: #ea580c; }
    .st-alaska { fill: #0891b2; }
    .st-hawaii { fill: #9333ea; }
    .st-arizona { fill: #047857; stroke-dasharray: 2; } /* Arizona MST permanente */

    /* Tooltip interactivo flotante en mapa */
    .map-tooltip {
      position: absolute;
      pointer-events: none;
      background: #1e293b;
      border: 1px solid var(--accent-orange);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 12px;
      color: #fff;
      display: none;
      z-index: 50;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
      transform: translate(-50%, -120%);
    }

    /* ============================================================ */
    /* 🗺️ VISTA 2: UNITED STATES (GEOGRAFÍA & BUSCADOR)            */
    /* ============================================================ */
    .search-filter-box {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 16px;
    }

    .input-search {
      flex: 1;
      min-width: 260px;
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 10px 14px 10px 38px;
      color: #fff;
      font-size: 13.5px;
      font-family: inherit;
      outline: none;
      transition: border-color var(--trans-speed);
    }
    .input-search:focus {
      border-color: var(--accent-orange);
    }

    .search-input-wrap {
      position: relative;
      flex: 1;
      min-width: 260px;
    }
    .search-input-wrap i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-dim);
    }

    .filter-tabs {
      display: flex;
      gap: 6px;
      overflow-x: auto;
    }
    .btn-filter {
      background: var(--bg-card-alt);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      padding: 8px 14px;
      font-size: 12px;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
      transition: all var(--trans-speed);
    }
    .btn-filter:hover, .btn-filter.active {
      background: var(--accent-orange-soft);
      border-color: var(--accent-orange);
      color: var(--accent-orange);
      font-weight: 600;
    }

    /* Tabla / Directorio de Estados */
    .states-table-container {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      overflow-x: auto;
    }

    .states-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }
    .states-table th {
      padding: 14px 18px;
      background: #0f1422;
      color: var(--text-dim);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-weight: 600;
      border-bottom: 1px solid var(--border-subtle);
    }
    .states-table td {
      padding: 14px 18px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      color: var(--text-main);
    }
    .states-table tr:hover td {
      background: var(--bg-card-hover);
    }

    .badge-zone {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-weight: 600;
    }
    .badge-zone.eastern { background: rgba(239, 68, 68, 0.15); color: #f87171; }
    .badge-zone.central { background: rgba(234, 179, 8, 0.15); color: #facc15; }
    .badge-zone.mountain { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .badge-zone.pacific { background: rgba(249, 115, 22, 0.15); color: #fb923c; }

    /* ============================================================ */
    /* 💬 VISTA 3: ENGLISH (CALL CENTER COMMON PHRASES)            */
    /* ============================================================ */
    .phrase-category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 18px;
    }

    .phrase-card {
      background: var(--bg-card-alt);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: all var(--trans-speed);
    }
    .phrase-card:hover {
      border-color: rgba(255, 102, 0, 0.35);
    }

    .phrase-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .phrase-category-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
      background: var(--accent-blue-soft);
      color: var(--accent-blue);
    }
    .phrase-category-badge.hipaa {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
    }
    .phrase-category-badge.hold {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
    }

    .phrase-english-text {
      font-size: 14.5px;
      font-weight: 600;
      color: #fff;
      line-height: 1.45;
    }

    .phrase-spanish-trans {
      font-size: 12px;
      color: var(--text-dim);
      font-style: italic;
    }

    .btn-copy-phrase {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      padding: 6px 12px;
      font-size: 12px;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s ease;
    }
    .btn-copy-phrase:hover {
      background: var(--accent-orange);
      color: #fff;
      border-color: var(--accent-orange);
    }
    .btn-copy-phrase.copied {
      background: var(--accent-green);
      color: #fff;
      border-color: var(--accent-green);
    }

    /* ============================================================ */
    /* 🏥 VISTA 4: WELLCARE SUPPORT & NOTEPAD (IMAGEN 3 NOTEPAD)    */
    /* ============================================================ */
    .wellcare-layout-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
    }
    @media (max-width: 1024px) {
      .wellcare-layout-grid {
        grid-template-columns: 1fr;
      }
    }

    .terms-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 14px;
    }

    .term-card {
      background: var(--bg-card-alt);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 14px;
    }
    .term-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--accent-blue);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .term-desc {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Notepad Rápido (Exacto a la Imagen 3) */
    .notepad-box {
      background: var(--bg-card-alt);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: fit-content;
    }
    .notepad-title {
      font-family: var(--font-head);
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .notepad-textarea {
      width: 100%;
      height: 220px;
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 12px;
      color: #fff;
      font-family: inherit;
      font-size: 13px;
      resize: vertical;
      outline: none;
    }
    .notepad-textarea:focus {
      border-color: var(--accent-orange);
    }
    .notepad-actions {
      display: flex;
      gap: 8px;
    }
    .btn-save-note {
      flex: 1;
      background: var(--accent-orange);
      color: #fff;
      border: none;
      padding: 10px;
      border-radius: var(--radius-sm);
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: background 0.2s;
    }
    .btn-save-note:hover {
      background: var(--accent-orange-hover);
    }
    .btn-clear-note {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-dim);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s;
    }
    .btn-clear-note:hover {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444;
      border-color: #ef4444;
    }

    /* ============================================================ */
    /* 🎓 VISTA 5: LEARN (NATO PHONETIC ALPHABET & SPELLER)         */
    /* ============================================================ */
    .speller-interactive-card {
      background: var(--bg-card-alt);
      border: 1px solid var(--accent-orange-soft);
      border-radius: var(--radius-md);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .speller-input {
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--accent-orange);
      outline: none;
      width: 100%;
    }
    .speller-input:focus {
      border-color: var(--accent-orange);
    }
    .speller-output {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      min-height: 48px;
      align-items: center;
      background: var(--bg-app);
      padding: 14px;
      border-radius: var(--radius-sm);
      border: 1px dashed var(--border-subtle);
    }
    .speller-pill {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 6px 12px;
      border-radius: var(--radius-pill);
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .speller-pill span {
      color: var(--accent-orange);
    }

    .nato-alphabet-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 10px;
    }
    .nato-item {
      background: var(--bg-card-alt);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 10px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .nato-letter {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      background: var(--accent-orange-soft);
      color: var(--accent-orange);
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
    }
    .nato-word {
      font-size: 13px;
      font-weight: 600;
      color: #fff;
    }

    /* Notificación Toast flotante */
    .toast-msg {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #10b981;
      color: #fff;
      padding: 12px 20px;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 13px;
      display: none;
      align-items: center;
      gap: 8px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      z-index: 9999;
      animation: slideUp 0.25s ease;
    }
    @keyframes slideUp {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>
</head>

