      { abbr: 'VT', name: 'Vermont', zone: 'Eastern', cap: 'Montpelier', codes: '802' },
      { abbr: 'VA', name: 'Virginia', zone: 'Eastern', cap: 'Richmond', codes: '276, 434, 540, 703, 804' },
      { abbr: 'WA', name: 'Washington', zone: 'Pacific', cap: 'Olympia', codes: '206, 253, 360, 425, 509' },
      { abbr: 'WV', name: 'West Virginia', zone: 'Eastern', cap: 'Charleston', codes: '304, 681' },
      { abbr: 'WI', name: 'Wisconsin', zone: 'Central', cap: 'Madison', codes: '262, 414, 608, 715, 920' },
      { abbr: 'WY', name: 'Wyoming', zone: 'Mountain', cap: 'Cheyenne', codes: '307' }
    ];

    function renderizarTablaEstados(filtroTexto = '', filtroZona = 'all') {
      const tbody = document.getElementById('statesTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const filtrados = DATOS_ESTADOS.filter(st => {
        const coincideZona = filtroZona === 'all' || st.zone.toLowerCase().includes(filtroZona.toLowerCase());
        const coincideTexto = st.name.toLowerCase().includes(filtroTexto.toLowerCase()) ||
                              st.abbr.toLowerCase().includes(filtroTexto.toLowerCase()) ||
                              st.cap.toLowerCase().includes(filtroTexto.toLowerCase()) ||
                              st.codes.includes(filtroTexto);
        return coincideZona && coincideTexto;
      });

      filtrados.forEach(st => {
        let tz = ZONAS.eastern;
        if (st.zone === 'Central') tz = ZONAS.central;
        if (st.zone === 'Mountain') tz = ZONAS.mountain;
        if (st.zone === 'Pacific') tz = ZONAS.pacific;
        if (st.zone === 'Alaska') tz = ZONAS.alaska;
        if (st.zone === 'Hawaii') tz = ZONAS.hawaii;

        const time = obtenerHoraFormateada(tz);
        const zoneClass = st.zone.toLowerCase();

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong style="color: #ff6600;">${st.abbr}</strong></td>
          <td><strong style="color: #fff;">${st.name}</strong></td>
          <td><span class="badge-zone ${zoneClass}">${st.zone}</span></td>
          <td><span style="font-family: monospace; font-weight: bold; color: #fff;">${time.digital} ${time.ampm}</span></td>
          <td style="color: #94a3b8;">${st.cap}</td>
          <td style="color: #64748b; font-size: 12px;">${st.codes}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    renderizarTablaEstados();

    const stateSearchInput = document.getElementById('stateSearchInput');
    let zonaFiltroActual = 'all';

    stateSearchInput.addEventListener('input', (e) => {
      renderizarTablaEstados(e.target.value, zonaFiltroActual);
    });

    function filtrarEstados(zona, btn) {
      zonaFiltroActual = zona;
      document.querySelectorAll('#view-usa .btn-filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderizarTablaEstados(stateSearchInput.value, zona);
    }

    // -------------------------------------------------------------
    // 6. FRASES EN INGLÉS PARA CALL CENTER (WELLCARE)
    // -------------------------------------------------------------
    const FRASES_DATA = [
      {
        cat: 'opening',
        catLabel: 'Apertura',
        badgeClass: '',
        en: 'Thank you for calling Wellcare Medicare Advantage. My name is [Your Name], how may I assist you today?',
        es: 'Gracias por llamar a Wellcare Medicare Advantage. Mi nombre es [Tu Nombre], ¿cómo puedo ayudarle hoy?'
      },
      {
        cat: 'opening',
        catLabel: 'Llamada Grabada',
        badgeClass: '',
        en: 'For quality and training purposes, this call may be recorded or monitored.',
        es: 'Por motivos de calidad y entrenamiento, esta llamada puede ser grabada o monitoreada.'
      },
      {
        cat: 'hipaa',
        catLabel: 'HIPAA Verification',
        badgeClass: 'hipaa',
        en: 'To protect your health privacy, may I please verify your full name, date of birth, and Member ID number?',
        es: 'Para proteger su privacidad de salud, ¿podría verificar su nombre completo, fecha de nacimiento y número de Member ID?'
      },
      {
        cat: 'hipaa',
        catLabel: 'HIPAA Address',
        badgeClass: 'hipaa',
        en: 'Could you also please confirm your current residential address including the zip code?',
        es: '¿Podría también confirmar su dirección de residencia actual incluyendo el código postal?'
      },
      {
        cat: 'hold',
        catLabel: 'Poner en Espera',
        badgeClass: 'hold',
        en: 'May I place you on a brief hold for 2 to 3 minutes while I review your account details?',
        es: '¿Puedo ponerlo en una breve espera de 2 a 3 minutos mientras reviso los detalles de su cuenta?'
      },
      {
        cat: 'hold',
        catLabel: 'Retomar Llamada',
        badgeClass: 'hold',
        en: 'Thank you so much for your patience while holding. I have that information ready for you.',
        es: 'Muchas gracias por su paciencia en la espera. Ya tengo esa información lista para usted.'
      },
      {
        cat: 'empathy',
        catLabel: 'Empatía / Molestia',
        badgeClass: '',
        en: 'I completely understand how frustrating this situation can be, and I am here to help you get this resolved.',
        es: 'Entiendo perfectamente lo frustrante que puede ser esta situación, y estoy aquí para ayudarle a resolverlo.'
      },
      {
        cat: 'empathy',
        catLabel: 'Aclaración de Cobertura',
        badgeClass: '',
        en: 'I will personally look into your benefits to ensure you get the exact coverage you are entitled to.',
        es: 'Revisaré personalmente sus beneficios para asegurarme de que obtenga la cobertura exacta a la que tiene derecho.'
      },
      {
        cat: 'closing',
        catLabel: 'Cierre de Llamada',
        badgeClass: '',
        en: 'Is there anything else I can assist you with regarding your Wellcare benefits today?',
        es: '¿Hay algo más en lo que pueda ayudarle con respecto a sus beneficios de Wellcare hoy?'
      },
      {
        cat: 'closing',
        catLabel: 'Despedida Formal',
        badgeClass: '',
        en: 'Thank you for choosing Wellcare. Your reference number for this call is [Ref#]. Have a wonderful rest of your day!',
        es: 'Gracias por elegir Wellcare. Su número de referencia para esta llamada es [Ref#]. ¡Que tenga un maravilloso día!'
      }
    ];

    function renderizarFrases(filtroTexto = '', filtroCat = 'all') {
      const grid = document.getElementById('phrasesGrid');
      if (!grid) return;
      grid.innerHTML = '';

      const filtradas = FRASES_DATA.filter(f => {
        const coincideCat = filtroCat === 'all' || f.cat === filtroCat;
        const coincideTexto = f.en.toLowerCase().includes(filtroTexto.toLowerCase()) ||
                              f.es.toLowerCase().includes(filtroTexto.toLowerCase()) ||
                              f.catLabel.toLowerCase().includes(filtroTexto.toLowerCase());
        return coincideCat && coincideTexto;
      });

      filtradas.forEach(f => {
        const card = document.createElement('div');
        card.className = 'phrase-card';
        card.innerHTML = `
          <div class="phrase-card-header">
            <span class="phrase-category-badge ${f.badgeClass}">${f.catLabel}</span>
          </div>
          <div class="phrase-english-text">"${f.en}"</div>
          <div class="phrase-spanish-trans">${f.es}</div>
          <button class="btn-copy-phrase" onclick="copiarTexto(this, \`${f.en.replace(/'/g, "\\'")}\`)">
            <i class="fa-solid fa-copy"></i> Copiar frase
          </button>
        `;
        grid.appendChild(card);
      });
    }

    renderizarFrases();

    const phraseSearchInput = document.getElementById('phraseSearchInput');
    let fraseCatActual = 'all';

    phraseSearchInput.addEventListener('input', (e) => {
      renderizarFrases(e.target.value, fraseCatActual);
    });

    function filtrarFrases(cat, btn) {
      fraseCatActual = cat;
      document.querySelectorAll('#view-english .btn-filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderizarFrases(phraseSearchInput.value, cat);
    }

    // Copiar al portapapeles con feedback
    function copiarTexto(btn, texto) {
      navigator.clipboard.writeText(texto).then(() => {
        btn.classList.add('copied');
        btn.innerHTML = '<i class="fa-solid fa-check"></i> ¡Copiado!';
        
        mostrarToast('¡Frase copiada al portapapeles!');

        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = '<i class="fa-solid fa-copy"></i> Copiar frase';
        }, 2000);
      });
    }

    function mostrarToast(msg) {
      const toast = document.getElementById('toastMsg');
      const toastText = document.getElementById('toastText');
      if (!toast) return;
      toastText.textContent = msg;
      toast.style.display = 'flex';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 2500);
    }

    // -------------------------------------------------------------
    // 7. NOTEPAD RÁPIDO (LOCALSTORAGE CLIENT-SIDE SEGURO)
    // -------------------------------------------------------------
    const NOTEPAD_KEY = 'timewii_advisor_notes_v1';
    const notepadText = document.getElementById('notepadText');

    // Cargar nota guardada al inicio
    if (localStorage.getItem(NOTEPAD_KEY)) {
      notepadText.value = localStorage.getItem(NOTEPAD_KEY);
    }

    function guardarNotaLocal() {
      localStorage.setItem(NOTEPAD_KEY, notepadText.value);
      mostrarToast('Nota guardada localmente en tu equipo');
    }

    function limpiarNotaLocal() {
      if (confirm('¿Deseas limpiar el bloc de notas rápido?')) {
        notepadText.value = '';
        localStorage.removeItem(NOTEPAD_KEY);
        mostrarToast('Bloc de notas limpiado');
      }
    }

    function irAWellcareNotepad() {
      // Activar vista Customer / Wellcare y hacer foco en el notepad
      const btn = document.querySelector('[data-view="view-customer"]');
      if (btn) btn.click();
      setTimeout(() => {
        notepadText.focus();
      }, 100);
    }

    // -------------------------------------------------------------
    // 8. APRENDIZAJE: SPELLER FONÉTICO & NATO ALPHABET
    // -------------------------------------------------------------
    const NATO_ALFABETO = {
      'A': 'Alpha',   'B': 'Bravo',    'C': 'Charlie', 'D': 'Delta',
      'E': 'Echo',    'F': 'Foxtrot',  'G': 'Golf',    'H': 'Hotel',
      'I': 'India',   'J': 'Juliett',  'K': 'Kilo',    'L': 'Lima',
      'M': 'Mike',    'N': 'November', 'O': 'Oscar',   'P': 'Papa',
      'Q': 'Quebec',  'R': 'Romeo',    'S': 'Sierra',  'T': 'Tango',
      'U': 'Uniform', 'V': 'Victor',   'W': 'Whiskey', 'X': 'X-ray',
      'Y': 'Yankee',  'Z': 'Zulu',
      '0': 'Zero',    '1': 'One',      '2': 'Two',     '3': 'Three',
      '4': 'Four',    '5': 'Five',     '6': 'Six',     '7': 'Seven',
      '8': 'Eight',   '9': 'Nine'
    };

    // Renderizar cuadrícula NATO
    const natoGrid = document.getElementById('natoGrid');
    if (natoGrid) {
      Object.entries(NATO_ALFABETO).forEach(([letra, palabra]) => {
        const item = document.createElement('div');
        item.className = 'nato-item';
        item.innerHTML = `
          <div class="nato-letter">${letra}</div>
          <div class="nato-word">${palabra}</div>
        `;
        natoGrid.appendChild(item);
      });
    }

    // Deletreador en vivo
    const spellerInput = document.getElementById('spellerInput');
    const spellerOutput = document.getElementById('spellerOutput');

    spellerInput.addEventListener('input', (e) => {
      const texto = e.target.value.toUpperCase().trim();
      spellerOutput.innerHTML = '';

      if (!texto) {
        spellerOutput.innerHTML = '<span style="color: var(--text-dim); font-size: 13px;">Las palabras fonéticas aparecerán aquí...</span>';
        return;
      }

      for (let char of texto) {
        if (NATO_ALFABETO[char]) {
          const pill = document.createElement('div');
          pill.className = 'speller-pill';
          pill.innerHTML = `<span>${char}:</span> ${NATO_ALFABETO[char]}`;
          spellerOutput.appendChild(pill);
        } else if (char === ' ') {
          const espacio = document.createElement('div');
          espacio.style.width = '12px';
          spellerOutput.appendChild(espacio);
        }
      }
    });
  </script>
