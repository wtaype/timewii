  <script is:inline>
    // -------------------------------------------------------------
    // 1. GESTOR DE RELOJES EN VIVO (USA TIME ZONES)
    // -------------------------------------------------------------
    const ZONAS = {
      eastern: 'America/New_York',
      central: 'America/Chicago',
      mountain: 'America/Denver',
      pacific: 'America/Los_Angeles',
      alaska: 'America/Anchorage',
      hawaii: 'Pacific/Honolulu'
    };

    function obtenerHoraFormateada(timeZone) {
      const ahora = new Date();
      const opciones = {
        timeZone,
        hour12: true,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      };
      const formateador = new Intl.DateTimeFormat('en-US', opciones);
      const partes = formateador.formatToParts(ahora);
      
      let hora = '', minuto = '', segundo = '', ampm = '';
      partes.forEach(p => {
        if (p.type === 'hour') hora = p.value;
        if (p.type === 'minute') minuto = p.value;
        if (p.type === 'second') segundo = p.value;
        if (p.type === 'dayPeriod') ampm = p.value.toUpperCase();
      });

      return {
        digital: `${hora}:${minuto}:${segundo}`,
        ampm: ampm || ''
      };
    }

    function actualizarRelojes() {
      // 1. Relojes detallados en Vista Time
      const eastern = obtenerHoraFormateada(ZONAS.eastern);
      const central = obtenerHoraFormateada(ZONAS.central);
      const mountain = obtenerHoraFormateada(ZONAS.mountain);
      const pacific = obtenerHoraFormateada(ZONAS.pacific);
      const alaska = obtenerHoraFormateada(ZONAS.alaska);
      const hawaii = obtenerHoraFormateada(ZONAS.hawaii);

      const elE = document.getElementById('clockEastern');
      const elC = document.getElementById('clockCentral');
      const elM = document.getElementById('clockMountain');
      const elP = document.getElementById('clockPacific');
      const elA = document.getElementById('clockAlaska');
      const elH = document.getElementById('clockHawaii');

      if (elE) elE.innerHTML = `${eastern.digital} <span class="clock-ampm">${eastern.ampm}</span>`;
      if (elC) elC.innerHTML = `${central.digital} <span class="clock-ampm">${central.ampm}</span>`;
      if (elM) elM.innerHTML = `${mountain.digital} <span class="clock-ampm">${mountain.ampm}</span>`;
      if (elP) elP.innerHTML = `${pacific.digital} <span class="clock-ampm">${pacific.ampm}</span>`;
      if (elA) elA.innerHTML = `${alaska.digital} <span class="clock-ampm">${alaska.ampm}</span>`;
      if (elH) elH.innerHTML = `${hawaii.digital} <span class="clock-ampm">${hawaii.ampm}</span>`;

      // 2. Tickers superiores en Topbar
      const tE = document.getElementById('tickerEDT');
      const tC = document.getElementById('tickerCDT');
      const tM = document.getElementById('tickerMDT');
      const tP = document.getElementById('tickerPDT');

      if (tE) tE.textContent = `${eastern.digital} ${eastern.ampm}`;
      if (tC) tC.textContent = `${central.digital} ${central.ampm}`;
      if (tM) tM.textContent = `${mountain.digital} ${mountain.ampm}`;
      if (tP) tP.textContent = `${pacific.digital} ${pacific.ampm}`;
    }

    setInterval(actualizarRelojes, 1000);
    actualizarRelojes();

    // -------------------------------------------------------------
    // 2. CONTROL DE NAVEGACIÓN ENTRE VISTAS (SIDEBAR)
    // -------------------------------------------------------------
