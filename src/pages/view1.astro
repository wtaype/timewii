        if (zone.includes('Pacific')) tz = ZONAS.pacific;
        if (zone.includes('Alaska')) tz = ZONAS.alaska;
        if (zone.includes('Hawaii')) tz = ZONAS.hawaii;

        const timeObj = obtenerHoraFormateada(tz);

        tooltip.innerHTML = `
          <strong>${name} (${abbr})</strong><br/>
          <span style="color: #94a3b8;">Zona:</span> ${zone}<br/>
          <span style="color: #94a3b8;">Hora:</span> <span style="color: #ff6600; font-weight: bold;">${timeObj.digital} ${timeObj.ampm}</span><br/>
          <span style="color: #94a3b8;">Capital:</span> ${cap}
