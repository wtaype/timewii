    const viewPanels = document.querySelectorAll('.view-panel');
    const topbarTitle = document.getElementById('topbarTitle');
    const topbarSubtitle = document.getElementById('topbarSubtitle');

    const TITULOS_VISTAS = {
      'view-time': { titulo: 'U.S. Time & Clocks', subtitulo: 'Horarios oficiales en tiempo real de todos los husos horarios de EE.UU.' },
      'view-usa': { titulo: 'United States Geography', subtitulo: 'Directorio de 50 estados, capitales, husos horarios y prefijos telefónicos' },
      'view-english': { titulo: 'English Call Center Scripts', subtitulo: 'Frases comunes de Wellcare listas para copiar al portapapeles' },
      'view-customer': { titulo: 'Wellcare Customer Support', subtitulo: 'Cheat sheet de términos de Medicare, checklist de llamada y bloc de notas' },
      'view-learn': { titulo: 'Learn & NATO Phonetic', subtitulo: 'Alfabeto fonético internacional y deletreador interactivo de pólizas' }
    };

    navItems.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetView = btn.getAttribute('data-view');
        
