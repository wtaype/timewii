---
// src/pages/geography.astro
// 🗺️ Módulo Geography: Husos Horarios, Mapa de EE.UU. y Directorio de Rapport
import Principal from '@core/layouts/Principal.astro';
---

<Principal titulo="Geography & Time • TimeWii">
  <div class="page-container">
    <div class="clean-card" style="margin-top: 1rem; text-align: center; padding: 3rem 1.5rem;">
      <i class="fa-solid fa-earth-americas" style="font-size: 2.5rem; color: var(--accent-cyan, #00d2ff); margin-bottom: 1rem; display: block;"></i>
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--tx1);">Geography & Husos Horarios USA</h2>
      <p style="color: var(--tx3); max-width: 600px; margin: 0.5rem auto 0;">
        Relojes en vivo de las 6 zonas horarias, Mapa Interactivo SVG y Directorio de 50 Estados para Rapport.
      </p>
    </div>
  </div>
</Principal>
