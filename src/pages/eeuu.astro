---
// src/pages/eeuu.astro
// 🇺🇸 Módulo EEUU & Cultura: Guía de Rapport Intercultural Perú ↔ USA
import Principal from '@core/layouts/Principal.astro';
---

<Principal titulo="EEUU & Cultura • TimeWii">
  <div class="page-container">
    <div class="clean-card" style="margin-top: 1rem; text-align: center; padding: 3rem 1.5rem;">
      <i class="fa-solid fa-flag-usa" style="font-size: 2.5rem; color: var(--mco); margin-bottom: 1rem; display: block;"></i>
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--tx1);">EEUU & Cultura para Rapport</h2>
      <p style="color: var(--tx3); max-width: 600px; margin: 0.5rem auto 0;">
        Guía de conexión cultural, festividades oficiales, etiqueta de conversación, clima y modismos respetuosos.
      </p>
    </div>
  </div>
</Principal>
